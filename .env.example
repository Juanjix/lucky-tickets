# Copy this file to .env.local and fill in real values from your Supabase
# project settings. Never commit .env.local — it's already git-ignored.
#
# These two are validated at startup by src/lib/env/client.ts and
# src/lib/env/server.ts. Both are safe to expose to the browser: the
# publishable key is meant to be public and relies on Row Level Security
# (RLS) policies, not secrecy, to protect data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RFC-007 — Mercado Pago Checkout Pro & Payment Processing.
# Validated by src/lib/env/server.ts's getPaymentServerEnv() and read only
# from server-only code (src/lib/mercado-pago/*, src/lib/supabase/service-role.ts,
# src/app/api/payments/**, src/app/api/webhooks/**). NEVER prefix any of
# these with NEXT_PUBLIC_ and never commit real values.
#
# MERCADO_PAGO_ACCESS_TOKEN: your Mercado Pago application's access token
# (sandbox/test credentials during development - see "Your integrations" >
# your application > "Test credentials" in the Mercado Pago developer
# panel). RFC-007 MVP scope: this is ONE server-side platform account
# shared by every organization, not a per-organizer credential — see
# docs/rfcs/RFC-007-mercado-pago-payments.md "Credential strategy" for why,
# and what a future RFC would need to change to support organizer-owned
# Mercado Pago accounts (payment_accounts already models the connection
# metadata for that, but RFC-007 does not populate or use it for
# credentials).
MERCADO_PAGO_ACCESS_TOKEN=

# MERCADO_PAGO_WEBHOOK_SECRET: the signing secret shown in "Your
# integrations" > your application > Webhooks > "Secret signature", used
# to verify the `x-signature` header on every inbound notification
# (src/lib/mercado-pago/signature.ts). Rotate this in the Mercado Pago
# panel, not in code, if it is ever exposed.
MERCADO_PAGO_WEBHOOK_SECRET=

# NEXT_PUBLIC_APP_URL: this deployment's own absolute base URL (e.g.
# https://your-domain.com, or an https tunnel URL in local development -
# see docs/rfcs/RFC-007-mercado-pago-payments.md "Local webhook
# development"). Used ONLY server-side today, to build Mercado Pago
# back_urls/notification_url from a trusted, fixed value - never from a
# request's Host/Origin header (RFC-007 section 48: prevents open
# redirects). Despite the NEXT_PUBLIC_ prefix (matching RFC-007's own
# suggested naming; this value is not a secret), no client code currently
# reads it.
NEXT_PUBLIC_APP_URL=

# SUPABASE_SERVICE_ROLE_KEY: from your Supabase project's API settings.
# Used ONLY by src/lib/supabase/service-role.ts, itself used ONLY to call
# confirm_order_payment (granted to service_role alone — see the RFC-007
# migration). Never imported by client code, never given broader use than
# that one narrow purpose. This is the single most sensitive value in this
# file: it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# RFC-008 — Ticket Issuance & Secure QR.
# Validated by src/lib/env/server.ts's getTicketServerEnv() and read only
# from server-only code (src/lib/tickets/*, src/features/tickets/*, the
# webhook->issuance call site). NEVER prefix either of these with
# NEXT_PUBLIC_ and never commit real values. Generate each with something
# like `openssl rand -base64 48`.
#
# TICKET_ACCESS_SIGNING_KEY: HMAC key for the buyer's stateless
# ticket-access capability (gates "can this browser view this order's
# tickets page"). Deliberately separate from QR_ENCRYPTION_KEY - never
# reuse one for the other.
TICKET_ACCESS_SIGNING_KEY=

# QR_ENCRYPTION_KEY: symmetric key Postgres uses (pgp_sym_encrypt/decrypt,
# via the RFC-008 migration's issue_tickets_for_order/get_order_tickets)
# to encrypt/decrypt each ticket's raw QR secret for buyer-facing
# redisplay. Never stored in the database. Rotating this key makes every
# previously-issued ticket's QR permanently undecryptable - treat it like
# SUPABASE_SERVICE_ROLE_KEY in terms of how carefully it must be guarded
# and backed up.
QR_ENCRYPTION_KEY=
