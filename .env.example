# Copy this file to .env.local and fill in real values from your Supabase
# project settings. Never commit .env.local — it's already git-ignored.
#
# These two are validated at startup by src/lib/env/client.ts and
# src/lib/env/server.ts. Both are safe to expose to the browser: the
# publishable key is meant to be public and relies on Row Level Security
# (RLS) policies, not secrecy, to protect data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (a service-role key, a payment provider's API key,
# etc.) will be added here, unprefixed, by the RFC that introduces them.
# They must never be prefixed with NEXT_PUBLIC_ and must only be read
# through src/lib/env/server.ts.
